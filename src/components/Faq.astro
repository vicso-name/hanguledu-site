---
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---

<div class="faq">
  {items.map((i) => (
    <details class="faq-i">
      <summary><span class="t-h3">{i.q}</span><span class="faq-ico" aria-hidden="true"></span></summary>
      <p class="t-body" set:html={i.a} />
    </details>
  ))}
</div>
