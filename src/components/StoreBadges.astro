---
// Store badges for the stores the app is live in; a store with no url renders nothing.
import { site, storeHref } from '../data/site';

// `page` overrides the page the store link is tagged with (a dialog tags its own campaign).
interface Props { class?: string; page?: string }
const page = Astro.props.page ?? Astro.url.pathname;
const badges = site.stores
  .map((s) => ({ ...s, href: storeHref(s, page) }))
  .filter((s) => s.href);
---

<div class:list={['he-cta__badges', Astro.props.class]}>
  {badges.map((b) => <a href={b.href} data-store={b.id} rel="noopener"><img src={b.badge} alt={b.label} width="150" height="44" /></a>)}
</div>
