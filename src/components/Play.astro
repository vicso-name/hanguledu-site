---
// Play button for a Korean clip. Renders nothing when no clip exists for `ko`,
// so a page never shows a button that cannot play.
import { hasClip } from '../lib/audio-index';

interface Props { ko: string; label?: string; slow?: boolean; size?: 'md' | 'sm'; class?: string }
const { ko, label, slow = false, size = 'md', class: cls } = Astro.props;
const ok = hasClip(ko);
---

{ok && (slow ? (
  <button type="button" class:list={['he-play he-play--slow', cls]} data-say={ko} data-slow aria-label={`Play ${label ?? ko} slowly`}>
    <svg class="he-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 13a6 6 0 1 0 12 0 4 4 0 1 0-8 0 2 2 0 0 0 4 0"></path><circle cx="10" cy="13" r="8"></circle><path d="M2 21h12c4.4 0 8-3.6 8-8V7a2 2 0 1 0-4 0v6"></path></svg>Slow
  </button>
) : (
  <button type="button" class:list={['he-play', size === 'sm' && 'he-play--sm', cls]} data-say={ko} aria-label={`Play ${label ?? ko}`}>
    <svg class="he-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor"></path></svg>
  </button>
))}
