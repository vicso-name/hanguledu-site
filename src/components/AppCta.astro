---
import StoreBadges from './StoreBadges.astro';
import icon from '../assets/app-icon.png';
import { Image } from 'astro:assets';

interface Props { title: string; sub?: string }
const { title, sub = 'Korean alphabet, 240 phrases and quiz games with Korean audio. Works offline.' } = Astro.props;
---

<section class="wrap sec--tight">
  <div class="he-glass he-cta">
    <Image class="he-cta__icon" src={icon} width={72} height={72} densities={[1, 2]} alt="Hangul Hero app icon" />
    <div class="he-cta__text"><p class="he-cta__title" data-cta-title={title}>{title}</p><p class="he-cta__sub">{sub}</p></div>
    <StoreBadges />
  </div>
</section>
