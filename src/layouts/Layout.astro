---
import '../styles/tokens.css';
import '../styles/components.css';
import '../styles/site.css';
import { site } from '../data/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Page JSON-LD; nothing is emitted when omitted. */
  schema?: Record<string, unknown> | Record<string, unknown>[];
  robots?: string;
}

// No default share image yet: og:image is emitted only when a page passes one.
const { title = site.title, description = site.description, image, schema, robots = 'index, follow' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Dark mode follows the device; set before first paint so there is no flash. -->
    <script is:inline>
      (function () {
        var m = window.matchMedia('(prefers-color-scheme: dark)');
        var set = function () { document.documentElement.dataset.theme = m.matches ? 'dark' : 'light'; };
        set();
        m.addEventListener('change', set);
      })();
    </script>
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700&display=swap" />

    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body class="pg he-backdrop">
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>

<script>
  import { wirePlayButtons } from '../lib/audio';
  import { onChange, knowsAll } from '../lib/progress';

  wirePlayButtons();

  // Romanization hints hang under syllables until the visitor knows every letter in them.
  onChange((set) => {
    document.querySelectorAll<HTMLElement>('[data-jamo]').forEach((el) => {
      el.classList.toggle('known', knowsAll(el.dataset.jamo!, set));
    });
  });
</script>
