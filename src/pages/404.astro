---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found | HangulEdu" robots="noindex">
  <section class="wrap sec wrap--medium" style="display: grid; gap: 16px; justify-items: start;">
    <p class="t-label">404</p>
    <h1 class="t-h1"><span lang="ko" class="ko">없어요</span>: it's not here.</h1>
    <p class="t-lead">없어요 (eopseoyo) means "there isn't any". The page you wanted may have moved.</p>
    <div class="row"><a class="he-btn" href="/korean-alphabet/chart/">Open the alphabet chart</a><a class="he-btn he-btn--outline" href="/">Home</a></div>
  </section>
</Layout>
