---
import Layout from '../layouts/Layout.astro';
import AppCta from '../components/AppCta.astro';
import StoreBadges from '../components/StoreBadges.astro';
import { Image } from 'astro:assets';
import appIcon from '../assets/app-icon.png';
import { site } from '../data/site';
import Play from '../components/Play.astro';
import Icon from '../components/Icon.astro';
import { ALL } from '../lib/progress';
import { PACKS } from '../data/phrases';
import { BY, initialRom, jamo, letterSyllable } from '../data/hangul';

const FIRST = [
  { g: 'ㅎ', rom: 'h', role: 'Consonant', cls: 'consonant', say: '하', hint: 'ㅎ sounds like h in "hat".' },
  { g: 'ㅏ', rom: 'a', role: 'Vowel', cls: 'vowel', say: '아', hint: 'ㅏ sounds like a in "father".' },
  { g: 'ㄴ', rom: 'n', role: 'Consonant', cls: 'consonant', say: '나', hint: 'ㄴ sounds like n in "no". At the bottom of a block it is a final consonant, a batchim.' },
];

// 안녕하세요 taken apart: each block, its letters and what to notice.
const HELLO = [
  { k: '안', rom: 'an', note: 'ㅇ is silent at the start of a block, so 안 begins with the vowel. ㄴ at the bottom closes it: an.' },
  { k: '녕', rom: 'nyeong', note: 'ㅕ is yu in "young". ㅇ at the bottom is not silent: it is ng, as in "sing".' },
  { k: '하', rom: 'ha', note: 'Two letters side by side: ㅎ is h in "hat", ㅏ is a in "father".' },
  { k: '세', rom: 'se', note: 'ㅅ is s in "sun", ㅔ is e in "bed".' },
  { k: '요', rom: 'yo', note: 'Silent ㅇ again, then ㅛ on the bottom: yo, as in "yoga".' },
].map((h) => ({
  ...h,
  // The third letter sits at the bottom, a batchim: ㅇ there is ng, not silent.
  letters: jamo(h.k).map((g, i) => ({
    g,
    say: letterSyllable(BY[g]),
    kind: i === 2 ? 'b' : BY[g].role === 'vowel' ? 'v' : 'c',
    rom: i === 2 && g === 'ㅇ' ? 'ng' : initialRom(BY[g]) || 'silent',
  })),
}));

// Phrases from the Hangul Hero app whose spelling and sound differ (pronunciationOverride).
const XRAY = [
  { w: '내가 지켜 줄게', s: '내가 지켜 줄께', en: "I'll protect you", rom: 'naega jikyeo julkke', tag: '게 → 께', rule: 'The ending -ㄹ게 is always said tense, [께], but written 게.', src: '/audio/phrases/kd_jikyeo_julge.mp3' },
  { w: '고백할게', s: '고배칼께', en: "I'm going to confess", rom: 'gobaekalkke', tag: 'ㄱ + ㅎ → ㅋ', rule: 'ㄱ and ㅎ merge into ㅋ, and the ending -ㄹ게 turns tense.', src: '/audio/phrases/lv_gobaek.mp3' },
  { w: '실수해서 죄송합니다', s: '실쑤해서 죄송함니다', en: "I'm sorry for the mistake", rom: 'silssuhaeseo joesonghamnida', tag: 'ㅂ → ㅁ', rule: 'ㅅ after ㄹ turns tense in 실수, and ㅂ turns into ㅁ before ㄴ.', src: '/audio/phrases/wk_silsu.mp3' },
];
const syls = (w: string, s: string) => [...w].map((k, i) => ({ k, hit: k !== s[i] }));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: site.url + '/',
  description: site.description,
};
---

<Layout
  title="Hangul Hero: An App to Learn Korean, Starting with Hangul | HangulEdu"
  description="Hangul Hero is an app for learning Korean: read Hangul in an afternoon, then 240 everyday phrases with audio. Try the first lessons here, free, no sign-up."
  schema={schema}
>
  <section class="wrap sec hero">
    <div class="split">
      <div class="hero-text">
        <p class="t-label">Hangul Hero · Korean learning app</p>
        <h1 class="t-display">Read Korean in an afternoon.</h1>
        <p class="t-lead">Hangul has 40 letters, and a king designed them in 1443 to be learned fast. Hangul Hero teaches them, then 240 everyday phrases with audio. Start right here: read your first word.</p>
        <div class="hero-cta">
          <StoreBadges class="hero-badges" />
          <a class="he-btn he-btn--outline" href="/korean-alphabet/chart/">See all 40 letters</a>
        </div>
        <div class="hero-app">
          <Image class="hero-app__icon" src={appIcon} width={44} height={44} densities={[1, 2]} alt="" />
          <p class="t-meta"><b>Free to start.</b> Quiz games, Korean audio, works offline.</p>
        </div>
      </div>

      <div class="he-glass first" data-first>
        <div class="first-head">
          <p class="t-label">Your first word</p>
          <ol class="first-steps" aria-label="Steps">
            <li data-step="1" aria-current="step">Hear</li>
            <li data-step="2">Read</li>
          </ol>
        </div>
        <p class="t-body" style="font-weight: 600;" data-first-intro>Tap the three letters to hear them.</p>
        <div class="first-tiles">
          {FIRST.map((l) => (
            <button type="button" class={`he-tile he-tile--${l.cls}`} data-g={l.g} data-say={l.say} data-hint={l.hint} aria-pressed="false">
              <span class="he-tile__glyph" lang="ko">{l.g}</span>
              <span class="he-tile__rom">{l.rom}</span>
              <span class="he-tile__role">{l.role}</span>
            </button>
          ))}
        </div>
        <p class="t-meta first-hint" data-first-hint hidden></p>

        <div class="first-row">
          <div class="block" aria-label="Syllable block" role="img">
            <div class="z z--c z--empty" data-z="ㅎ" style="font-size: 56px;"><small>1</small><span lang="ko"></span></div>
            <div class="z z--v z--empty" data-z="ㅏ" style="font-size: 56px;"><small>2</small><span lang="ko"></span></div>
            <div class="z z--b z--empty" data-z="ㄴ" style="font-size: 40px;"><small>3</small><span lang="ko"></span></div>
          </div>
          <div class="first-side">
            <p class="t-body" data-first-how>Each letter drops into the block. Korean is read like a page: <b class="nw">top-left</b>, then <b>right</b>, then <b>bottom</b>.</p>
            <div data-first-quiz hidden>
              <p class="t-body" style="font-weight: 700; margin-bottom: 10px;">How do you read this block?</p>
              <div class="first-opts">
                {['han', 'nah', 'hun'].map((o) => <button type="button" class="opt" data-opt={o}>{o}</button>)}
              </div>
              <div class="feedback feedback--try" data-first-wrong hidden style="margin-top: 10px;">Not quite. Top-left first, then right, then bottom: h + a + n.</div>
            </div>
            <div class="first-win" data-first-right hidden>
              <p class="first-word" lang="ko">한<small lang="en">han</small></p>
              <p class="t-body">You just read Korean. Add <span lang="ko" class="ko">글</span> (geul) and you get <span lang="ko" class="ko">한글</span>, Hangul: the name of the alphabet itself.</p>
            </div>
          </div>
        </div>

        <div class="first-done" data-first-done hidden>
          <p class="t-body" style="font-weight: 600;">37 letters to go. Hangul Hero takes you through them, then on to real phrases.</p>
          <div class="first-done__row">
            <StoreBadges />
            <button type="button" class="he-btn he-btn--quiet" data-first-reset>Start again</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap sec--tight">
    <div class="he-glass he-glass--dense learns" data-learns>
      <div class="lw-text">
        <div class="head" style="margin: 0;">
          <p class="t-label">How Hangul Hero teaches</p>
          <h2 class="t-h2">Every word comes apart into letters.</h2>
          <p class="t-body he-ink-2">Korean packs its letters into blocks, one block per syllable. Learn the letters and a new word stops being a picture to memorize: you take it apart and read it. Tap a block of 안녕하세요 to see how.</p>
        </div>
        <ol class="lw-steps">
          <li><span class="lw-n">1</span><span>The 40 letters, each one with sound.</span></li>
          <li><span class="lw-n">2</span><span>Letters packed into blocks, so you can read any word.</span></li>
          <li><span class="lw-n">3</span><span>240 everyday phrases, each with an X-Ray of how it is really said.</span></li>
        </ol>
      </div>

      <div class="lw-stage">
        <div class="lw-top">
          <p class="t-label"><span lang="ko">안녕하세요</span> · "Hello"</p>
          <Play ko="안녕하세요" label="annyeonghaseyo" size="sm" />
        </div>
        <div class="lw-word" lang="ko" role="group" aria-label="Blocks of 안녕하세요">
          {HELLO.map((h, i) => (
            <button type="button" class="lw-syl" data-lw={i} aria-pressed={String(i === 0)}>
              <b>{h.k}</b>
              <em lang="en">{h.rom}</em>
            </button>
          ))}
        </div>
        {HELLO.map((h, i) => (
          <div class="lw-part" data-lw-part={i} hidden={i > 0}>
            <div class="lw-sum" lang="ko">
              {h.letters.map((l, j) => (
                <>
                  {j > 0 && <span class="lw-plus" aria-hidden="true">+</span>}
                  <button type="button" class={`lw-chip lw-chip--${l.kind}`} data-say={l.say} aria-label={`Play ${l.g}, ${l.rom}`}>
                    <b>{l.g}</b>
                    <small lang="en">{l.rom}</small>
                  </button>
                </>
              ))}
              <span class="lw-plus" aria-hidden="true">=</span>
              <span class="lw-res"><b>{h.k}</b><small lang="en">{h.rom}</small></span>
            </div>
            <p class="t-body">{h.note}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="wrap sec">
    <div class="head">
      <p class="t-label">Tools, not articles</p>
      <h2 class="t-h2">Every page lets you do something.</h2>
      <p class="t-body he-ink-2">Listen, build, pick, check. Free, on your phone, no sign-up.</p>
    </div>
    <div class="tcards">
      <article class="he-glass tcard">
        <div class="tcard-pre">
          <div class="tp-letters" lang="ko" aria-hidden="true">
            {[...'ㄱㄴㄷㄹ'].map((g) => <span class="jm jm--c">{g}</span>)}
            {[...'ㅏㅓㅗㅜ'].map((g) => <span class="jm jm--v">{g}</span>)}
          </div>
        </div>
        <div class="tcard-body">
          <p class="t-label">Alphabet</p>
          <h3 class="t-h3"><a class="tcard-link" href="/korean-alphabet/chart/">Alphabet chart</a></h3>
          <p class="t-meta">Hear all 40 letters. Hide the romanization to test yourself.</p>
        </div>
      </article>
      <article class="he-glass tcard">
        <div class="tcard-pre">
          <div class="tp-trio" lang="ko">
            {[['가', 'ga'], ['카', 'ka'], ['까', 'kka']].map(([k, r]) => (
              <button type="button" class="tp-say" data-say={k} aria-label={`Play ${k}, ${r}`}><b>{k}</b><small lang="en"><Icon name="play_arrow" />{r}</small></button>
            ))}
          </div>
        </div>
        <div class="tcard-body">
          <p class="t-label">Alphabet</p>
          <h3 class="t-h3"><a class="tcard-link" href="/korean-alphabet/consonants/"><span lang="ko">가, 카</span> or <span lang="ko">까</span>?</a></h3>
          <p class="t-meta">The three-way contrast English lacks. Tap to hear it here, then test your ears.</p>
        </div>
      </article>
      <article class="he-glass tcard">
        <div class="tcard-pre">
          <div class="tp-sum" lang="ko" aria-hidden="true">
            <span class="jm jm--c">ㅎ</span><i>+</i><span class="jm jm--v">ㅏ</span><i>+</i><span class="jm jm--b">ㄴ</span><i>=</i><b>한</b>
          </div>
        </div>
        <div class="tcard-body">
          <p class="t-label">Alphabet</p>
          <h3 class="t-h3"><a class="tcard-link" href="/korean-alphabet/#builder">Block builder</a></h3>
          <p class="t-meta">Put letters together and watch a syllable take shape.</p>
        </div>
      </article>
      <article class="he-glass tcard">
        <div class="tcard-pre">
          <div class="tp-grid" lang="ko" aria-hidden="true">
            {['가나다라마', '거너더러머', '고노도로모'].map((r) => [...r].map((k) => <span>{k}</span>))}
          </div>
        </div>
        <div class="tcard-body">
          <p class="t-label">Alphabet</p>
          <h3 class="t-h3"><a class="tcard-link" href="/korean-alphabet/chart/#syllables">190 blocks with sound</a></h3>
          <p class="t-meta">Every consonant with every basic vowel, out loud.</p>
        </div>
      </article>
      <article class="he-glass tcard">
        <div class="tcard-pre">
          <div class="tp-packs" aria-hidden="true">
            {PACKS.filter((p) => ['kdrama', 'food', 'love', 'work'].includes(p.id)).map((p) => <span><Icon name={p.icon} />{p.title}</span>)}
          </div>
        </div>
        <div class="tcard-body">
          <p class="t-label">Phrases</p>
          <h3 class="t-h3"><a class="tcard-link" href="/phrases/">240 phrases with audio</a></h3>
          <p class="t-meta">Search by English or Korean, filter by situation and politeness.</p>
        </div>
      </article>
      <article class="he-glass tcard">
        <div class="tcard-pre">
          <div class="tp-pick" aria-hidden="true">
            <span><em>A close friend</em><b lang="ko">고마워</b></span>
            <span class="on"><em>A shop assistant</em><b lang="ko">감사합니다</b></span>
          </div>
        </div>
        <div class="tcard-body">
          <p class="t-label">Phrases</p>
          <h3 class="t-h3"><a class="tcard-link" href="/phrases/thank-you-in-korean/">Pick the right thank you</a></h3>
          <p class="t-meta">Say who you are talking to and get the form that fits.</p>
        </div>
      </article>
    </div>
  </section>

  <section class="wrap sec--tight">
    <div class="facts facts--live">
      <div class="he-glass he-glass--dense fact">
        <div class="fact-head"><b>40</b><p class="t-meta">letters, each one you can hear</p></div>
        <div class="grid40" lang="ko" role="img" aria-label="Your letters out of 40" data-grid40>
          {[...ALL].map((g, i) => <span class="cell" data-g={g} data-r={i < 19 ? 'c' : 'v'}>{g}</span>)}
        </div>
        <p class="t-meta"><span data-mine-count>0</span> of them are yours so far. Every letter you learn lights up here. <a href="/korean-alphabet/chart/">Open the chart</a></p>
      </div>
      <div class="he-glass he-glass--dense fact" data-xray>
        <div class="fact-head"><b>240</b><p class="t-meta">phrases in the Hangul Hero app, each with an X-Ray of how it is really said</p></div>
        {XRAY.map((x, i) => (
          <div class="xr-item" data-xr={i} hidden={i > 0}>
            <div class="xr" lang="ko">
              <div class="xr-line"><span class="t-label" lang="en">Written</span><span class="xr-syl">{syls(x.w, x.s).map((s) => <span class:list={[s.hit && 'hit', s.k === ' ' && 'gap']}>{s.k}</span>)}</span></div>
              <div class="xr-line"><span class="t-label" lang="en">Said</span><span class="xr-syl">{syls(x.s, x.w).map((s) => <span class:list={[s.hit && 'hit', s.k === ' ' && 'gap']}>{s.k}</span>)}</span></div>
            </div>
            <div style="display: grid; gap: 2px;">
              <p class="t-h3">{x.en}</p>
              <p class="rom">{x.rom}</p>
            </div>
            <p class="he-rule" style="margin: 0;"><span class="he-rule__tag">{x.tag}</span><span>{x.rule}</span></p>
            <div class="row">
              <button type="button" class="he-play" data-src={x.src} aria-label={`Play ${x.en}`}><svg class="he-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor"></path></svg></button>
              <button type="button" class="he-btn he-btn--outline" data-xr-next>Next phrase · {i + 1}/{XRAY.length}</button>
            </div>
          </div>
        ))}
      </div>
      <div class="he-glass he-glass--dense fact">
        <div class="fact-head"><b>0</b><p class="t-meta">sign-ups. Your progress is saved in this browser, nowhere else.</p></div>
        <div class="kept">
          <p class="t-label">Saved here now</p>
          <div class="row" style="gap: 6px;" data-kept hidden></div>
          <p class="t-body" data-kept-none>Nothing yet. Tap a letter in the <a href="/korean-alphabet/chart/">chart</a> and watch it appear here.</p>
        </div>
        <button type="button" class="he-btn he-btn--outline" data-clear disabled style="justify-self: start;">Clear my progress</button>
      </div>
    </div>
  </section>

  <AppCta title="Take Hangul to your phone" />
</Layout>

<script>
  import { clear, onChange } from '../lib/progress';

  // Your first word: ㅎ ㅏ ㄴ fill the block, then a one-question quiz. Nothing is saved.
  const card = document.querySelector<HTMLElement>('[data-first]')!;
  const q = <T extends HTMLElement>(s: string) => card.querySelector<T>(s)!;
  const tiles = [...card.querySelectorAll<HTMLButtonElement>('.he-tile')];
  const done = new Set<string>();
  let picked = '';

  function paintFirst() {
    tiles.forEach((t) => {
      const on = done.has(t.dataset.g!);
      t.classList.toggle('he-tile--learned', on);
      t.setAttribute('aria-pressed', String(on));
    });
    card.querySelectorAll<HTMLElement>('[data-z]').forEach((z) => {
      const on = done.has(z.dataset.z!);
      z.classList.toggle('z--empty', !on);
      z.querySelector('span')!.textContent = on ? z.dataset.z! : '';
    });
    const all = done.size === 3;
    const won = picked === 'han';
    card.querySelectorAll<HTMLElement>('[data-step]').forEach((s) => {
      const n = Number(s.dataset.step);
      s.classList.toggle('is-done', n === 1 ? all : won);
      s.toggleAttribute('aria-current', n === 1 ? !all : all && !won);
    });
    q('[data-first-intro]').hidden = all;
    q('[data-first-how]').hidden = all;
    q('[data-first-quiz]').hidden = !all || won;
    q('[data-first-right]').hidden = !won;
    q('[data-first-done]').hidden = !won;
    q('[data-first-wrong]').hidden = !picked || won;
    if (all) q('[data-first-hint]').hidden = true;
    card.classList.toggle('is-won', won);
    card.querySelectorAll<HTMLElement>('[data-opt]').forEach((o) => {
      o.classList.toggle('is-right', !!picked && o.dataset.opt === 'han');
      o.classList.toggle('is-off', !!picked && o.dataset.opt !== 'han' && o.dataset.opt !== picked);
    });
  }

  tiles.forEach((t) => t.addEventListener('click', () => {
    done.add(t.dataset.g!);
    const hint = q('[data-first-hint]');
    hint.textContent = t.dataset.hint!;
    hint.hidden = done.size === 3;
    paintFirst();
  }));
  card.querySelectorAll<HTMLElement>('[data-opt]').forEach((o) => o.addEventListener('click', () => {
    picked = o.dataset.opt!;
    paintFirst();
  }));
  q('[data-first-reset]').addEventListener('click', () => {
    done.clear();
    picked = '';
    paintFirst();
  });
  paintFirst();

  // How Hangul Hero teaches: tap a block of 안녕하세요 to take it apart.
  const learns = document.querySelector<HTMLElement>('[data-learns]')!;
  const syls = [...learns.querySelectorAll<HTMLButtonElement>('[data-lw]')];
  syls.forEach((b) => b.addEventListener('click', () => {
    syls.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    learns.querySelectorAll<HTMLElement>('[data-lw-part]').forEach((p) => (p.hidden = p.dataset.lwPart !== b.dataset.lw));
  }));

  // Live facts: the 40 grid and what is saved.
  const kept = document.querySelector<HTMLElement>('[data-kept]')!;
  onChange((set) => {
    document.querySelectorAll<HTMLElement>('[data-grid40] .cell').forEach((c) => {
      c.className = 'cell' + (set.has(c.dataset.g!) ? ' on--' + c.dataset.r : '');
    });
    document.querySelector('[data-mine-count]')!.textContent = String(set.size);
    kept.replaceChildren(...[...set].map((g) => {
      const s = document.createElement('span');
      s.lang = 'ko';
      s.className = 'jm jm--' + ('ㅏㅑㅓㅕㅗㅛㅜㅠㅡㅣㅐㅒㅔㅖㅘㅙㅚㅝㅞㅟㅢ'.includes(g) ? 'v' : 'c');
      s.textContent = g;
      return s;
    }));
    kept.hidden = set.size === 0;
    document.querySelector<HTMLElement>('[data-kept-none]')!.hidden = set.size > 0;
    document.querySelector<HTMLButtonElement>('[data-clear]')!.disabled = set.size === 0;
    const title = document.querySelector<HTMLElement>('[data-cta-title]');
    if (title) title.textContent = set.size ? `Take your ${set.size} letters to your phone` : title.dataset.ctaTitle!;
  });
  document.querySelector('[data-clear]')!.addEventListener('click', () => clear());

  // X-Ray: step through three phrases.
  const items = [...document.querySelectorAll<HTMLElement>('[data-xr]')];
  items.forEach((it, i) => it.querySelector('[data-xr-next]')!.addEventListener('click', () => {
    it.hidden = true;
    const next = items[(i + 1) % items.length];
    next.hidden = false;
    next.querySelector<HTMLElement>('[data-xr-next]')!.focus();
  }));
</script>
