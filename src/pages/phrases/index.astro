---
import Layout from '../../layouts/Layout.astro';
import PhraseRow from '../../components/PhraseRow.astro';
import Faq from '../../components/Faq.astro';
import AppCta from '../../components/AppCta.astro';
import Icon from '../../components/Icon.astro';
import { PACKS, PHRASES, REGISTER_LABEL, type Register } from '../../data/phrases';
import { PHRASE_PAGES } from '../../data/phrase-pages';
import { crumbs, faqPage } from '../../lib/schema';

const HUBS: Record<string, string> = { kdrama: '/phrases/k-drama/', love: '/phrases/love/' };
const REGS: Register[] = ['casual', 'polite', 'formal'];
const differ = PHRASES.filter((p) => p.said !== p.ko).length;
const PAGE = 10;

const FAQ = [
  { q: 'What are casual, polite and formal Korean?', a: 'Korean changes the end of a sentence for who you talk to. Casual (반말) is for friends and younger people, polite (해요체, ending in 요) is for most adults, and formal (합쇼체, ending in 니다) is for work, news and ceremonies.' },
  { q: 'Why does the X-Ray show a different spelling?', a: `Korean is not always said the way it is spelled: consonants slide into the next block, and some change before others. ${differ} of these ${PHRASES.length} phrases sound different from how they are written.` },
  { q: 'Is the audio a real person?', a: 'The audio is synthesized Korean speech, the same clips as in the Hangul Hero app. You can play every phrase at normal speed or slowly.' },
];

const schema = [
  { '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Korean phrases with audio', inLanguage: 'en', numberOfItems: PHRASES.length },
  crumbs([['Phrases', '/phrases/']]),
  faqPage(FAQ),
];
---

<Layout
  title="How Do You Say It in Korean? 240 Phrases with Audio | HangulEdu"
  description="How do you say it in Korean? 240 everyday Korean phrases and expressions with audio and how each one really sounds: greetings, food, travel, shopping, feelings, love, health, work."
  schema={schema}
>
  <section class="wrap page-head">
    <div class="head">
      <h1 class="t-h1">Korean phrases with audio</h1>
      <p class="t-lead">How do you say it in Korean? Search {PHRASES.length} everyday phrases from the Hangul Hero app, in 8 situations. {differ} of them are said differently from how they are written; tap any phrase to see what changes.</p>
    </div>
  </section>

  <section class="wrap sec--flush">
    <div class="packs">
      {PHRASE_PAGES.slice(0, 7).map((o) => <a class="he-glass pack" href={`/phrases/${o.slug}/`}><b lang="ko" class="prow-ko">{o.forms[o.hero].ko}</b><span class="t-body">{o.h1.replace('How to say ', '').replace(/^./, (c) => c.toUpperCase())}</span></a>)}
      <a class="he-glass pack" href="/phrases/basic-korean-phrases/"><b lang="ko" class="prow-ko">기본</b><span class="t-body">Basic phrases to start with</span></a>
    </div>
  </section>

  <section class="wrap sec--tight wrap--full" data-plist>
    <div class="pfilter">
      <div class="pfilter-top">
        <input class="psearch" aria-label="Search phrases" type="search" placeholder="Search: thank you, 주세요, taxi…" autocomplete="off" data-q />
        <div class="seg" role="group" aria-label="Politeness" data-f="reg">
          <button type="button" data-v="" aria-pressed="true">Any</button>
          {REGS.map((r) => <button type="button" data-v={r} aria-pressed="false">{REGISTER_LABEL[r]}</button>)}
        </div>
      </div>
      <div class="chips" role="group" aria-label="Situation" data-f="pack">
        <button type="button" data-v="" aria-pressed="true">All situations</button>
        {PACKS.map((p) => <button type="button" data-v={p.id} aria-pressed="false"><Icon name={p.icon} />{p.title}</button>)}
      </div>
      <p class="t-meta pcount" aria-live="polite" data-count>Showing {PAGE} of {PHRASES.length} phrases</p>
    </div>
    <ul class="plist plist--2" style="margin-top: 12px;">{PHRASES.map((p, i) => <PhraseRow p={p} hidden={i >= PAGE} />)}</ul>
    <button type="button" class="he-btn he-btn--outline pmore" data-more>Show {PAGE} more</button>
    <p class="t-body he-ink-2" data-empty hidden>No phrase matches. Try a shorter word.</p>
    <p class="t-meta" style="margin-top: 16px;">Packs with their own page: {PACKS.filter((p) => HUBS[p.id]).map((p, i) => <>{i > 0 && ' · '}<a class="pack-tag" href={HUBS[p.id]}><Icon name={p.icon} />{p.title}</a></>)}</p>
  </section>

  <section class="wrap sec--tight wrap--full">
    <h2 class="t-h2 faq-title">Questions</h2>
    <Faq items={FAQ} />
  </section>

  <AppCta title="All 240 phrases, offline, with games" />
</Layout>

<script>
  const root = document.querySelector<HTMLElement>('[data-plist]')!;
  const rows = [...root.querySelectorAll<HTMLElement>('.prow')];
  const q = root.querySelector<HTMLInputElement>('[data-q]')!;
  const count = root.querySelector<HTMLElement>('[data-count]')!;
  const empty = root.querySelector<HTMLElement>('[data-empty]')!;
  const more = root.querySelector<HTMLButtonElement>('[data-more]')!;
  const PAGE = 10;
  const f = { pack: '', reg: '' };
  let limit = PAGE;

  // at most `limit` matches are shown; "Show more" raises it a page at a time
  function apply() {
    const term = q.value.trim().toLowerCase();
    let n = 0;
    for (const r of rows) {
      const match = (!f.pack || r.dataset.pack === f.pack) && (!f.reg || r.dataset.reg === f.reg) && (!term || r.dataset.q!.includes(term));
      if (match) n++;
      r.hidden = !match || n > limit;
    }
    const shown = Math.min(n, limit);
    count.textContent = shown < n ? `Showing ${shown} of ${n} phrases` : `${n} phrase${n === 1 ? '' : 's'}`;
    more.hidden = shown >= n;
    more.textContent = `Show ${Math.min(PAGE, n - shown)} more`;
    empty.hidden = n > 0;
  }

  function reset() { limit = PAGE; apply(); }

  root.querySelectorAll<HTMLElement>('[data-f]').forEach((seg) => {
    seg.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button');
      if (!b) return;
      seg.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      f[seg.dataset.f as 'pack' | 'reg'] = b.dataset.v!;
      reset();
    });
  });
  q.addEventListener('input', reset);
  more.addEventListener('click', () => {
    const before = rows.filter((r) => !r.hidden).length;
    limit += PAGE;
    apply();
    rows.filter((r) => !r.hidden)[before]?.querySelector('summary')?.focus();
  });
</script>
