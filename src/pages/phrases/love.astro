---
import PackPage from '../../components/PackPage.astro';

const FAQ = [
  { q: 'What do Korean couples call each other?', a: '자기야 (jagiya, "honey") is the most common. 여보 (yeobo) is for married couples. Women often call an older boyfriend 오빠 (oppa).' },
  { q: 'How do you confess in Korean?', a: '좋아해 ("I like you") usually comes first. 사귈래? ("will you go out with me?") makes it official. 사랑해 comes later.' },
  { q: 'Are these phrases casual?', a: 'Most are, because couples speak banmal to each other. Add 요 to soften a phrase for someone you have just started dating.' },
];
---

<PackPage
  pack="love"
  title="30 Romantic Korean Phrases for Love and Dating, with Audio | HangulEdu"
  description="Romantic Korean phrases with audio: from 너 좋아해 and 우리 사귈래 to 자기야 and 나도 사랑해. Each one with meaning, when couples say it, and how it really sounds."
  h1="30 romantic Korean phrases"
  lead="From a first crush to 자기야: the Love & Dating pack from Hangul Hero. Every card plays the phrase and shows how it is really said."
  faq={FAQ}
  cta="Love & Dating: 30 phrases in the app"
/>
