---
import Layout from '../../layouts/Layout.astro';
import BlockBuilder from '../../components/BlockBuilder.astro';
import MouthFamilies from '../../components/MouthFamilies.astro';
import VowelSeeds from '../../components/VowelSeeds.astro';
import Faq from '../../components/Faq.astro';
import AppCta from '../../components/AppCta.astro';
import Icon from '../../components/Icon.astro';
import { ofGroup, letterSyllable } from '../../data/hangul';
import { crumbs, faqPage } from '../../lib/schema';

const STEPS = [
  { n: 1, r: 'c', title: 'Basic consonants', letters: ofGroup('basicC').map((l) => l.g).join(''), href: '/korean-alphabet/consonants/', what: 'Five mouth shapes and the letters built from them.' },
  { n: 2, r: 'v', title: 'Basic vowels', letters: ofGroup('basicV').map((l) => l.g).join(''), href: '/korean-alphabet/vowels/', what: 'Three strokes: sky, earth, person.' },
  { n: 3, r: 'c', title: 'Syllable blocks', letters: '', href: '#builder', what: 'Put letters together: consonant, vowel, final consonant.' },
  { n: 4, r: 'c', title: 'Double consonants', letters: ofGroup('double').map((l) => l.g).join(''), href: '/korean-alphabet/consonants/#plain-aspirated-tense', what: 'Tense sounds: 까 against 가 and 카.' },
  { n: 5, r: 'v', title: 'Combined vowels', letters: ofGroup('combV').map((l) => l.g).join(''), href: '/korean-alphabet/vowels/', what: 'Two vowels in one, and which ones sound the same.' },
];

// "Your 40": consonants and vowels as a table; each double consonant sits under the letter it doubles.
const basicC = ofGroup('basicC');
const UNDER = Object.fromEntries(['ㄲㄱ', 'ㄸㄷ', 'ㅃㅂ', 'ㅆㅅ', 'ㅉㅈ'].map(([d, b]) => [d, basicC.findIndex((l) => l.g === b) + 1]));
const TABLE = [
  { r: 'c', title: 'Consonants', total: 19, parts: '14 basic, 5 double', rows: [{ letters: basicC }, { letters: ofGroup('double'), under: true }] },
  { r: 'v', title: 'Vowels', total: 21, parts: '10 basic, 11 combined', rows: [{ letters: ofGroup('basicV') }, { letters: ofGroup('combV') }] },
];
// learning order of the five steps, for "next up"
const ORDER = (['basicC', 'basicV', 'double', 'combV'] as const).flatMap((k) => ofGroup(k).map((l) => l.g)).join('');

const FAQ = [
  { q: 'How many letters are in the Korean alphabet?', a: 'Modern Hangul uses 40 letters: 19 consonants (14 basic, 5 double) and 21 vowels (10 basic, 11 combined). The original 1443 alphabet had 28 letters; four fell out of use, and the double and combined letters are built from the rest.' },
  { q: 'How long does it take to learn Hangul?', a: 'Most learners can read the letters, slowly, after a few hours of focused practice, and read comfortably after a week or two of daily review. Reading is not the same as understanding: you will be able to sound out words long before you know what they mean.' },
  { q: 'Who invented the Korean alphabet?', a: 'King Sejong the Great and the scholars of his court created Hangul in 1443 and published it in 1446 as <i>Hunminjeongeum</i>, "the correct sounds for teaching the people". Before that, Korean was written with Chinese characters, which few people could read.' },
  { q: 'Is Hangul hard to learn?', a: 'It is one of the easiest writing systems to learn. Each letter stands for one sound, the shapes follow a logic you can see, and there are only 24 basic letters. The harder part comes later: sound changes between blocks, which our X-Ray shows in every phrase.' },
  { q: 'Should I learn romanization first?', a: 'No. Romanization is a crutch that teaches English sounds for Korean letters. Use it only until you know a letter; on this site it disappears under each letter as soon as you mark it as yours.' },
];

const schema = [
  { '@context': 'https://schema.org', '@type': 'Course', name: 'The Korean alphabet (Hangul)', description: 'Learn the 40 letters of Hangul in five steps, with audio.', provider: { '@type': 'Organization', name: 'HangulEdu', sameAs: 'https://hanguledu.com/' }, isAccessibleForFree: true, inLanguage: 'en', hasCourseInstance: { '@type': 'CourseInstance', courseMode: 'online', courseWorkload: 'PT3H' }, offers: { '@type': 'Offer', price: 0, priceCurrency: 'USD', category: 'Free' } },
  crumbs([['Korean alphabet', '/korean-alphabet/']]),
  faqPage(FAQ),
];
---

<Layout
  title="Korean Alphabet (Hangul): Learn the 40 Letters with Audio | HangulEdu"
  description="Hangul in five steps: 19 consonants and 21 vowels with audio, how King Sejong designed each letter, a syllable block builder, and progress that stays in your browser."
  schema={schema}
>
  <section class="wrap page-head">
    <div class="head">
      <h1 class="t-h1">The Korean alphabet, Hangul</h1>
      <p class="t-lead">Hangul (한글) has 40 letters: 19 consonants and 21 vowels. They were designed in 1443 to be easy, and they are. The letters are pictures of your mouth and three simple strokes, packed into square blocks of one syllable each.</p>
      <div class="row hero-cta">
        <a class="he-btn" href="/korean-alphabet/chart/">Open the chart</a>
        <a class="he-btn he-btn--outline" href="#builder">Build a block</a>
      </div>
    </div>

    <div class="he-glass he-glass--dense m40" data-m40 data-order={ORDER}>
      <div class="m40-top">
        <p class="m40-num" aria-label="Letters you know out of 40"><b data-mine-count>0</b><span>/40</span></p>
        <div class="m40-meter">
          <div class="m40-bar" aria-hidden="true"><i class="m40-bar__c" data-bar="c"></i><i class="m40-bar__v" data-bar="v"></i></div>
          <p class="t-body" data-msg="0">Start with <b class="ko" lang="ko">ㄱ</b>. Tap any letter to hear it, then mark the ones you know in the chart.</p>
          <p class="t-body" data-msg="some" hidden>Next up: <b class="ko" lang="ko" data-next>ㄱ</b>. <span data-left>40</span> letters to go.</p>
          <p class="t-body" data-msg="all" hidden>All 40 are yours. Now read them in real words: <a href="/phrases/">try the phrases</a>.</p>
        </div>
        <a class="d-link" href="/korean-alphabet/chart/">Mark letters in the chart</a>
      </div>
      {TABLE.map((t) => (
        <div class="m40-grp">
          <div class="m40-lab">
            <p class="t-h3"><i class={`m40-dot m40-dot--${t.r}`}></i>{t.title}</p>
            <p class="t-meta"><b class="m40-n"><span data-n={t.r}>0</span> of {t.total}</b><span class="m40-parts">{t.parts}</span></p>
          </div>
          <div class="m40-rows" lang="ko">
            {t.rows.map((row) => (
              <div class:list={['m40-row', row.under && 'm40-row--under']}>
                {row.letters.map((l) => (
                  <button type="button" class="m40-c" data-g={l.g} data-r={t.r} data-say={letterSyllable(l)} aria-label={`${l.g}, ${l.rom}`} style={row.under ? `--col: ${UNDER[l.g]}` : undefined}>
                    <b>{l.g}</b><small lang="en">{l.rom.replaceAll(' ', '')}</small>
                  </button>
                ))}
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="wrap sec--tight">
    <div class="head">
      <p class="t-label">Five steps</p>
      <h2 class="t-h2">Learn Hangul in this order</h2>
      <p class="t-body he-ink-2">Each step builds on the one before. The cards fill in as you mark letters in the chart.</p>
    </div>
    <ol class="path">
      {STEPS.map((s) => (
        <li class="path-i" data-step={s.letters}>
          <span class="path-node" aria-hidden="true"><span class="path-n">{s.n}</span><Icon name="check" /></span>
          <a class="he-glass he-glass--dense path-card" href={s.href}>
            <span class="path-main">
              <span class="path-title"><span class="t-h3">{s.title}</span><span class="path-tag">Up next</span></span>
              <span class="t-meta">{s.what}</span>
            </span>
            {s.letters ? (
              <span class="path-letters" lang="ko">{[...s.letters].map((g) => <i data-g={g} data-r={s.r}>{g}</i>)}</span>
            ) : (
              <span class="path-letters path-letters--block" lang="ko"><i data-r="c" class="on">ㄱ</i><em>+</em><i data-r="v" class="on">ㅏ</i><em>=</em><b>가</b></span>
            )}
            <span class="path-prog">
              {s.letters ? (
                <>
                  <span class="t-meta path-count"><b data-step-n>0</b> of {s.letters.length}</span>
                  <span class={`path-bar path-bar--${s.r}`}><i data-step-bar></i></span>
                </>
              ) : (
                <span class="t-meta path-count">Try the builder</span>
              )}
            </span>
            <Icon name="chevron_right" class="path-go" />
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="wrap sec" id="builder">
    <div class="head">
      <p class="t-label">Step 3</p>
      <h2 class="t-h2">Build a syllable block</h2>
      <p class="t-body he-ink-2">Korean does not write letters in a line. It stacks them into one square per syllable: a consonant, a vowel, and sometimes a final consonant underneath. Pick the letters and hear the block.</p>
    </div>
    <BlockBuilder />
  </section>

  <section class="wrap sec--tight">
    <div class="head">
      <p class="t-label">Why the letters look like this</p>
      <h2 class="t-h2">An alphabet you can work out</h2>
      <p class="t-body he-ink-2">Most alphabets grew by accident. Hangul was designed, and its designers wrote down their logic in 1446. Tap any letter to hear it.</p>
    </div>
    <div class="cols-2 work">
      <div class="he-glass he-glass--dense work-card">
        <div class="work-head">
          <h3 class="t-h2">Consonants draw your mouth</h3>
          <p class="t-body he-ink-2">Add a stroke for more breath, double a letter to make it tense.</p>
        </div>
        <MouthFamilies />
        <a class="d-link" href="/korean-alphabet/consonants/">All 19 consonants</a>
      </div>
      <div class="he-glass he-glass--dense work-card">
        <div class="work-head">
          <h3 class="t-h2">Vowels grow from three strokes</h3>
          <p class="t-body he-ink-2">Sky, earth and person; a second dot adds y.</p>
        </div>
        <VowelSeeds />
        <a class="d-link" href="/korean-alphabet/vowels/">All 21 vowels</a>
      </div>
    </div>
  </section>

  <section class="wrap sec--tight wrap--full">
    <h2 class="t-h2 faq-title">Questions</h2>
    <Faq items={FAQ} />
  </section>

  <AppCta title="Learn all 40 with spaced review" sub="Hangul Hero brings back each letter right before you would forget it. Works offline." />
</Layout>

<script>
  import { onChange } from '../../lib/progress';

  onChange((set) => {
    const card = document.querySelector<HTMLElement>('[data-m40]')!;
    const next = [...card.dataset.order!].find((g) => !set.has(g));
    const n = { c: 0, v: 0 };
    card.querySelectorAll<HTMLElement>('.m40-c').forEach((c) => {
      const on = set.has(c.dataset.g!);
      if (on) n[c.dataset.r as 'c' | 'v']++;
      c.classList.toggle('on--' + c.dataset.r, on);
      c.classList.toggle('is-next', c.dataset.g === next);
    });
    (['c', 'v'] as const).forEach((r) => {
      card.querySelector<HTMLElement>(`[data-n="${r}"]`)!.textContent = String(n[r]);
      card.querySelector<HTMLElement>(`[data-bar="${r}"]`)!.style.width = (n[r] / 40) * 100 + '%';
    });
    const state = set.size === 0 ? '0' : next ? 'some' : 'all';
    card.querySelectorAll<HTMLElement>('[data-msg]').forEach((p) => (p.hidden = p.dataset.msg !== state));
    card.querySelector('[data-next]')!.textContent = next ?? '';
    card.querySelector('[data-left]')!.textContent = String(40 - set.size);
    document.querySelectorAll('[data-mine-count]').forEach((el) => (el.textContent = String(set.size)));
    // the first step not finished yet is "up next"; step 3 has no letters and is never marked
    let nextSet = false;
    document.querySelectorAll<HTMLElement>('[data-step]').forEach((s) => {
      const letters = [...s.dataset.step!];
      if (!letters.length) return;
      s.querySelectorAll<HTMLElement>('.path-letters i').forEach((i) => i.classList.toggle('on', set.has(i.dataset.g!)));
      const n = letters.filter((g) => set.has(g)).length;
      const done = n === letters.length;
      s.querySelector('[data-step-n]')!.textContent = String(n);
      s.querySelector<HTMLElement>('[data-step-bar]')!.style.width = (n / letters.length) * 100 + '%';
      s.classList.toggle('is-done', done);
      s.classList.toggle('is-next', !done && !nextSet);
      if (!done) nextSet = true;
    });
  });
</script>
